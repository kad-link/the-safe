# the-safe SMS Gateway Configuration
# Optional: Set credentials below for live SMS dispatch to physical mobile phones

# Option 1: Fast2SMS (Recommended for India +91 mobile numbers)
# Sign up at https://www.fast2sms.com to get your API Authorization Key
FAST2SMS_API_KEY=

# Option 2: Twilio (Global SMS Gateway)
# Sign up at https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 3: Custom SMS Webhook URL
# SMS_WEBHOOK_URL=https://your-sms-webhook-endpoint.com/send
